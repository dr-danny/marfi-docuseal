  .marfi-status-pill.is-completed { background: rgba(22, 163, 74, .12); color: #15803d; border-color: rgba(22, 163, 74, .25); }
  .marfi-status-pill.is-opened { background: rgba(217, 119, 6, .12); color: #b45309; border-color: rgba(217, 119, 6, .25); }
