  .marfi-status-pill.is-declined { background: rgba(222, 60, 75, .1); color: #de3c4b; border-color: rgba(222, 60, 75, .25); }
  .marfi-agreements-cell.is-agreement { min-width: 200px; max-width: 320px; }
  .marfi-agreements-cell.is-signer { min-width: 150px; }
  .marfi-agreements-cell.is-author { min-width: 120px; }
  .marfi-agreements-cell.is-access { width: 120px; }
  .marfi-agreements-cell.is-status { width: 120px; }
