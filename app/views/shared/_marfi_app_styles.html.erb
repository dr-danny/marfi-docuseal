<style>
  @font-face {
    font-family: 'MARFI Auth Syne';
    font-style: normal;
    font-weight: 500 700;
    font-display: swap;
    src: url('/fonts/syne-500-700-latin.woff2') format('woff2');
  }

  @font-face {
    font-family: 'MARFI Auth Mono';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/dm-mono-500-latin.woff2') format('woff2');
  }

  .marfi-app {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: #f2eee7;
    color: #08090d;
    color-scheme: light;
  }

  .marfi-app-header {
    background: #08090d;
    border-bottom: 1px solid rgba(255, 255, 255, .14);
    color: #f2eee7;
  }
  .marfi-app-header-inner {
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    min-height: 72px;
    padding: 16px 0;
  }
  .marfi-app-header a { color: #f2eee7; }
  .marfi-app-header a:hover { color: #ff5362; }
  .marfi-app-header .dropdown-content {
    color: #08090d;
    background: #fff;
  }
  .marfi-app-header .dropdown-content a,
  .marfi-app-header .dropdown-content button {
    color: #08090d;
    opacity: 1;
  }
  .marfi-app-header .dropdown-content a:hover,
  .marfi-app-header .dropdown-content button:hover {
    color: #de3c4b;
    background: #f7f4ee;
  }
  .marfi-app-header .dropdown-content .marfi-sign-out {
    color: #de3c4b;
  }
  .marfi-app-header .dropdown-content .marfi-sign-out:hover {
    color: #ff5362;
    background: #f7f4ee;
  }

  .marfi-app-header-search { min-width: 0; }
  .marfi-app-header-search .input {
    width: 30rem !important;
    max-width: min(30rem, 42vw);
    height: 40px;
    background: #f7f4ee;
    color: #08090d;
    border: 1px solid transparent;
    border-radius: 999px;
    padding-left: 16px;
  }
  .marfi-app-header-search .input::placeholder { color: #6f717a; }
  .marfi-app-header-search .input:hover,
  .marfi-app-header-search .input:focus {
    border-color: #ff5362;
    outline: none;
    box-shadow: none;
  }
  .marfi-app-header-search .btn-ghost {
    color: #08090d;
    background: transparent;
  }
  .marfi-app-header-search .btn-ghost:hover { color: #de3c4b; background: transparent; }

  .marfi-app-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    background: rgba(247, 244, 238, .08);
    border: 1px solid rgba(247, 244, 238, .14);
    border-radius: 999px;
  }
  .marfi-app-nav-tabs,
  .marfi-app-actions form,
  .marfi-app-actions open-modal-mobile { display: contents; }
  .marfi-app-action {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 40px;
    margin: 0;
    padding: 0;
    color: #f2eee7;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    line-height: 0;
  }
  .marfi-app-action:hover,
  .marfi-app-action:focus-visible {
    color: #ff5362;
    border-color: #ff5362;
    background: transparent;
    outline: none;
  }
  .marfi-app-action.is-active {
    color: #f2eee7;
    background: #de3c4b;
    border-color: #de3c4b;
  }
  .marfi-app-action.is-create {
    color: #08090d;
    background: #f7f4ee;
    border-color: #f7f4ee;
  }
  .marfi-app-action.is-create:hover,
  .marfi-app-action.is-create:focus-visible {
    color: #de3c4b;
    border-color: #ff5362;
    background: #f7f4ee;
  }
  .marfi-app-action.is-archive:hover,
  .marfi-app-action.is-archive:focus-visible,
  .marfi-archive-action:hover,
  .marfi-archive-action:focus-visible {
    color: #de3c4b;
    border-color: #de3c4b;
    background: transparent;
  }
  .marfi-app-action.is-archive:hover svg,
  .marfi-app-action.is-archive:focus-visible svg,
  .marfi-archive-action:hover svg,
  .marfi-archive-action:focus-visible svg {
    color: #de3c4b;
    stroke: currentColor;
  }
  .marfi-app-action-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .marfi-app-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #f2eee7;
    font: 700 17px 'MARFI Auth Syne', sans-serif;
    letter-spacing: .18em;
  }
  .marfi-app-brand img { width: 36px; height: 36px; }
  .marfi-app-product {
    font: 500 11px 'MARFI Auth Mono', monospace;
    letter-spacing: .12em;
    color: #ff5362;
  }

  .marfi-app-avatar {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #de3c4b;
    color: #f2eee7;
    border-radius: 50%;
    font: 500 11px 'MARFI Auth Mono', monospace;
  }

  .marfi-app-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    padding: 36px 0 48px;
    gap: 28px;
  }
  .marfi-app-main > dashboard-dropzone {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .marfi-app h1 {
    font-family: 'MARFI Auth Syne', sans-serif;
    letter-spacing: -.04em;
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1.05;
  }
  .marfi-app-main .group\/header { margin-bottom: 0 !important; gap: 20px; }
  .marfi-app-main .grid.gap-4 {
    gap: 24px !important;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)) !important;
  }
  .marfi-app-main .grid.gap-4.mb-6 { margin-bottom: 0 !important; }
  .marfi-app-main .grid.gap-4 > a {
    min-height: 148px;
    padding: 28px 32px;
    border-radius: 0;
    background: #fff;
    border: 1px solid rgba(8, 9, 13, .1);
  }
  .marfi-app-main .grid.gap-4 > a:hover { border-color: #de3c4b; }

  .marfi-app .white-button {
    min-height: 48px;
    padding: 0 18px;
    border-radius: 0;
    border-color: #de3c4b;
    background: #de3c4b;
    color: #f2eee7;
    text-transform: uppercase;
    letter-spacing: .07em;
    font: 500 11px 'MARFI Auth Mono', monospace;
  }
  .marfi-app .white-button:hover { background: transparent; color: #de3c4b; }

  .marfi-dropzone-form { margin-top: 0 !important; }
  .marfi-dropzone-area {
    height: 160px;
    border-radius: 0 !important;
    background: #fff;
    border-color: rgba(8, 9, 13, .16) !important;
  }
  .marfi-dropzone-area:hover { background: #fff; border-color: #de3c4b !important; }

  .marfi-app-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px 30px;
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    padding: 20px 0 28px;
    border-top: 1px solid rgba(8, 9, 13, .14);
    color: #6f717a;
    font: 500 10px/1.7 'MARFI Auth Mono', monospace;
  }
  .marfi-app-footer a { color: #6f717a; text-decoration: underline; text-underline-offset: 3px; }
  .marfi-app-footer a:hover { color: #08090d; }

  @media (max-width: 760px) {
    .marfi-app-header-inner, .marfi-app-main, .marfi-app-footer { width: calc(100% - 32px); }
    .marfi-dropzone-area { height: 140px; }
    .marfi-app-header-search .input {
      width: 0 !important;
      max-width: none;
    }
    .marfi-app-header-search:focus-within .input,
    .marfi-app-header-search .input.input-outlined {
      width: 100% !important;
    }
  }

  .marfi-new-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .marfi-new-panel {
    background: #fff;
    border: 1px solid rgba(8, 9, 13, .1);
    padding: 28px;
    min-height: 280px;
  }
  .marfi-new-panel-title {
    font-family: 'MARFI Auth Syne', sans-serif;
    font-size: 22px;
    letter-spacing: -.03em;
    margin-bottom: 8px;
  }
  .marfi-new-panel-copy {
    color: #6f717a;
    margin-bottom: 18px;
    font-size: 14px;
  }
  .marfi-new-panel .marfi-dropzone-area { height: 220px; }
  .marfi-agreements-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin: 4px 0 14px;
  }
  .marfi-status-tabs {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    background: #08090d;
    border: 1px solid #08090d;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(242, 238, 231, .08);
  }
  .marfi-status-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 34px;
    padding: 0 16px;
    border-radius: 999px;
    color: rgba(242, 238, 231, .68);
    font: 500 11px/1 'MARFI Auth Mono', monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid transparent;
    transition: color .15s ease, background .15s ease, border-color .15s ease;
  }
  .marfi-status-tab:hover,
  .marfi-status-tab:focus-visible {
    color: #f2eee7;
    border-color: rgba(255, 83, 98, .45);
    outline: none;
  }
  .marfi-status-tab.is-active {
    color: #fffaf3;
    background: #de3c4b;
    border-color: #de3c4b;
    box-shadow: 0 0 0 1px rgba(222, 60, 75, .35);
  }
  .marfi-agreements-filters {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .marfi-agreements-filters > .dropdown > label,
  .marfi-agreements-filters .marfi-filter-trigger,
  .marfi-agreements-filters > div.flex.h-10 {
    min-height: 40px;
    border-radius: 999px !important;
    border: 1px solid rgba(8, 9, 13, .14) !important;
    background: #fffaf3 !important;
    color: #08090d !important;
    font: 500 11px/1 'MARFI Auth Mono', monospace !important;
    letter-spacing: .06em;
    text-transform: uppercase;
    box-shadow: none !important;
  }
  .marfi-agreements-filters > .dropdown > label:hover,
  .marfi-agreements-filters .marfi-filter-trigger:hover,
  .marfi-agreements-filters > div.flex.h-10:hover {
    border-color: #de3c4b !important;
    color: #de3c4b !important;
    background: #fff !important;
  }
  .marfi-agreements-filters .marfi-filter-trigger.is-active,
  .marfi-agreements-filters > .dropdown > label.is-active,
  .marfi-agreements-filters > div.flex.h-10.border-neutral-700 {
    background: #de3c4b !important;
    border-color: #de3c4b !important;
    color: #fffaf3 !important;
  }
  .marfi-agreements-filters .marfi-filter-trigger.is-active:hover,
  .marfi-agreements-filters > .dropdown > label.is-active:hover,
  .marfi-agreements-filters > div.flex.h-10.border-neutral-700:hover {
    background: #c92f3d !important;
    border-color: #c92f3d !important;
    color: #fffaf3 !important;
  }
  .marfi-agreements-filters .dropdown-content,
  .marfi-agreements-filters .dropdown-content.menu {
    min-width: 220px !important;
    margin-top: 10px !important;
    padding: 8px !important;
    border-radius: 14px !important;
    border: 1px solid rgba(8, 9, 13, .12) !important;
    background: #fffaf3 !important;
    color: #08090d !important;
    box-shadow: 0 18px 40px rgba(8, 9, 13, .16) !important;
  }
  .marfi-agreements-filters .dropdown-content li > a,
  .marfi-agreements-filters .dropdown-content li > * {
    border-radius: 10px !important;
    color: #08090d !important;
    font: 500 12px/1.2 'MARFI Auth Mono', monospace !important;
    letter-spacing: .04em;
    text-transform: uppercase;
    gap: 10px;
    padding: 10px 12px !important;
  }
  .marfi-agreements-filters .dropdown-content li > a:hover,
  .marfi-agreements-filters .dropdown-content li > *:hover,
  .marfi-agreements-filters .dropdown-content li > a:focus {
    background: #08090d !important;
    color: #f2eee7 !important;
  }
  .marfi-agreements-filters .dropdown-content li > a:hover svg,
  .marfi-agreements-filters .dropdown-content li > *:hover svg {
    color: #ff5362 !important;
    stroke: #ff5362 !important;
  }
  @media (max-width: 760px) {
    .marfi-status-tabs { width: 100%; justify-content: space-between; }
    .marfi-status-tab { flex: 1; justify-content: center; padding: 0 10px; }
  }

  .marfi-agreements-shell {
    background: #fffaf3;
    border: 1px solid rgba(8, 9, 13, .12);
    border-radius: 16px;
    overflow: auto;
  }
  .marfi-agreements-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    min-width: 1180px;
  }
  .marfi-agreements-table th {
    text-align: left;
    font: 500 11px/1.2 'MARFI Auth Mono', monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #f2eee7;
    padding: 15px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
    background: #08090d;
    white-space: nowrap;
  }
  .marfi-agreements-table th:first-child { padding-left: 20px; }
  .marfi-agreements-table th:last-child { padding-right: 20px; }
  .marfi-agreements-table td {
    padding: 15px 16px;
    border-bottom: 1px solid rgba(8, 9, 13, .08);
    vertical-align: middle;
    color: #08090d;
    background: #fffaf3;
  }
  .marfi-agreements-table td:first-child { padding-left: 20px; }
  .marfi-agreements-table td:last-child { padding-right: 20px; }
  .marfi-agreements-row:last-child td { border-bottom: 0; }
  .marfi-agreements-row:hover td { background: #f7f4ee; }
  .marfi-agreements-title {
    color: #08090d;
    font: 600 14px/1.35 'MARFI Auth Syne', sans-serif;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .marfi-agreements-title:hover { color: #de3c4b; }
  .marfi-agreements-meta,
  .marfi-agreements-muted {
    color: #6f717a;
    font: 500 11px/1.3 'MARFI Auth Mono', monospace;
    letter-spacing: .02em;
    margin-top: 4px;
  }
  .marfi-agreements-signers,
  .marfi-agreements-cell.is-author {
    font: 500 13px/1.35 'MARFI Auth Syne', sans-serif;
  }
  .marfi-agreements-signers {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .marfi-agreements-cell.is-sent,
  .marfi-agreements-cell.is-activity {
    font: 500 12px/1.3 'MARFI Auth Mono', monospace;
    letter-spacing: .02em;
    color: #3d3f48;
    white-space: nowrap;
  }
  .marfi-status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 92px;
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    font: 500 11px/1 'MARFI Auth Mono', monospace;
    letter-spacing: .06em;
    text-transform: uppercase;
    border: 1px solid transparent;
  }
  .marfi-status-pill.is-completed {
    background: rgba(8, 9, 13, .92);
    color: #f2eee7;
    border-color: #08090d;
  }
  .marfi-status-pill.is-opened {
    background: rgba(222, 60, 75, .12);
    color: #a91f31;
    border-color: rgba(222, 60, 75, .28);
  }
  .marfi-status-pill.is-sent,
  .marfi-status-pill.is-awaiting {
    background: #f2eee7;
    color: #08090d;
    border-color: rgba(8, 9, 13, .16);
  }
  .marfi-status-pill.is-declined {
    background: rgba(222, 60, 75, .14);
    color: #de3c4b;
    border-color: rgba(222, 60, 75, .3);
  }
  .marfi-agreements-cell.is-agreement { min-width: 220px; max-width: 340px; }
  .marfi-agreements-cell.is-signer { min-width: 150px; }
  .marfi-agreements-cell.is-author { min-width: 130px; }
  .marfi-agreements-cell.is-access { width: 110px; }
  .marfi-agreements-cell.is-status { width: 118px; }
  .marfi-agreements-cell.is-sent,
  .marfi-agreements-cell.is-activity { width: 126px; }
  .marfi-agreements-table th.is-actions,
  .marfi-agreements-cell.is-actions {
    width: 148px;
    text-align: right;
    white-space: nowrap;
  }
  .marfi-agreements-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    min-height: 36px;
    white-space: nowrap;
  }
  .marfi-agreements-action-form {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    line-height: 0;
  }
  .marfi-agreements-icon {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 36px;
    color: #08090d;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0;
    margin: 0;
    cursor: pointer;
    text-decoration: none;
    line-height: 0;
    vertical-align: middle;
    transition: color .15s ease, background .15s ease, border-color .15s ease;
  }
  .marfi-agreements-icon:hover,
  .marfi-agreements-icon:focus-visible {
    color: #de3c4b;
    border-color: #de3c4b;
    background: #fff;
    outline: none;
  }
  .marfi-agreements-icon.is-spacer {
    visibility: hidden;
    pointer-events: none;
    border-color: transparent;
    background: transparent;
  }
    .marfi-agreements-icon.is-sign {
    color: #fffaf3;
    background: #de3c4b;
    border-color: #de3c4b;
  }
  .marfi-agreements-icon.is-sign:hover,
  .marfi-agreements-icon.is-sign:focus-visible {
    color: #fffaf3;
    background: #c92f3d;
    border-color: #c92f3d;
  }
  .marfi-agreements-icon.is-danger:hover,
  .marfi-agreements-icon.is-danger:focus-visible {
    color: #de3c4b;
    border-color: #de3c4b;
    background: rgba(222, 60, 75, .08);
  }
  .marfi-agreements-icon .disabled { display: none; }
  .marfi-agreements-icon[disabled] .enabled,
  .marfi-agreements-icon.is-loading .enabled { display: none; }
  .marfi-agreements-icon[disabled] .disabled,
  .marfi-agreements-icon.is-loading .disabled { display: inline-flex; }
  .marfi-access-stack {
    display: inline-flex;
    align-items: center;
  }
  .marfi-access-avatar {
    width: 28px;
    height: 28px;
    margin-left: -8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 2px solid #fffaf3;
    background: #08090d;
    color: #f2eee7;
    font: 500 10px/1 'MARFI Auth Mono', monospace;
    letter-spacing: .04em;
  }
  .marfi-access-avatar:first-child { margin-left: 0; }
  .marfi-access-avatar.is-more {
    background: #f2eee7;
    color: #08090d;
    border-color: rgba(8, 9, 13, .12);
  }
  @media (max-width: 900px) {
    .marfi-new-grid { grid-template-columns: 1fr; }
  }

  /* Filter dropdown + turbo modals (Document History / filter forms) */
  .marfi-agreements-filters .dropdown-content.marfi-filter-menu,
  .marfi-filter-menu.dropdown-content {
    min-width: 220px !important;
    margin-top: 10px !important;
    padding: 8px !important;
    border-radius: 14px !important;
    border: 1px solid rgba(8, 9, 13, .12) !important;
    background: #fffaf3 !important;
    color: #08090d !important;
    box-shadow: 0 18px 40px rgba(8, 9, 13, .16) !important;
  }
  .marfi-filter-menu li > a,
  .marfi-filter-menu li > * {
    border-radius: 10px !important;
    color: #08090d !important;
    font: 500 12px/1.2 'MARFI Auth Mono', monospace !important;
    letter-spacing: .04em;
    text-transform: uppercase;
    gap: 10px;
    padding: 10px 12px !important;
    justify-content: flex-start !important;
  }
  .marfi-filter-menu li > a:hover,
  .marfi-filter-menu li > *:hover,
  .marfi-filter-menu li > a:focus {
    background: #08090d !important;
    color: #f2eee7 !important;
  }
  .marfi-filter-menu li > a:hover svg,
  .marfi-filter-menu li > *:hover svg,
  .marfi-filter-menu li > a:focus svg {
    color: #ff5362 !important;
    stroke: #ff5362 !important;
  }

  .marfi-modal {
    --marfi-ink: #08090d;
    --marfi-cream: #fffaf3;
    --marfi-paper: #f2eee7;
    --marfi-red: #de3c4b;
  }
  .marfi-modal .marfi-modal-backdrop {
    background: rgba(8, 9, 13, .55) !important;
  }
  .marfi-modal .marfi-modal-box,
  .marfi-modal .marfi-modal-panel,
