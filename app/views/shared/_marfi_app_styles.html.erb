<style>
  @font-face {
    font-family: 'MARFI Auth Syne';
    font-style: normal;
    font-weight: 500 700;
    font-display: swap;
    src: url('/fonts/syne-500-700-latin.woff2') format('woff2');
  }

  @font-face {
    font-family: 'MARFI Auth Mono';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/dm-mono-500-latin.woff2') format('woff2');
  }

  .marfi-app {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: #f2eee7;
    color: #08090d;
    color-scheme: light;
  }

  .marfi-app-header {
    background: #08090d;
    border-bottom: 1px solid rgba(255, 255, 255, .14);
    color: #f2eee7;
  }
  .marfi-app-header-inner {
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    min-height: 72px;
    padding: 16px 0;
  }
  .marfi-app-header a { color: #f2eee7; }
  .marfi-app-header a:hover { color: #ff5362; }
  .marfi-app-header #account_settings_button {
    color: #b9bac1;
    font: 500 11px 'MARFI Auth Mono', monospace;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .marfi-app-header #account_settings_button:hover { color: #f2eee7; }

  .marfi-app-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #f2eee7;
    font: 700 17px 'MARFI Auth Syne', sans-serif;
    letter-spacing: .18em;
  }
  .marfi-app-brand img { width: 36px; height: 36px; }
  .marfi-app-product {
    font: 500 11px 'MARFI Auth Mono', monospace;
    letter-spacing: .12em;
    color: #ff5362;
  }

  .marfi-app-avatar {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #de3c4b;
    color: #f2eee7;
    border-radius: 0;
    font: 500 11px 'MARFI Auth Mono', monospace;
  }

  .marfi-app-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    padding: 36px 0 48px;
    gap: 28px;
  }
  .marfi-app-main > dashboard-dropzone {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .marfi-app h1 {
    font-family: 'MARFI Auth Syne', sans-serif;
    letter-spacing: -.04em;
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1.05;
  }
  .marfi-app-main .group\/header { margin-bottom: 0 !important; gap: 20px; }
  .marfi-app-main .grid.gap-4 {
    gap: 24px !important;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)) !important;
  }
  .marfi-app-main .grid.gap-4.mb-6 { margin-bottom: 0 !important; }
  .marfi-app-main .grid.gap-4 > a {
    min-height: 148px;
    padding: 28px 32px;
    border-radius: 0;
    background: #fff;
    border: 1px solid rgba(8, 9, 13, .1);
  }
  .marfi-app-main .grid.gap-4 > a:hover { border-color: #de3c4b; }

  .marfi-app .white-button {
    min-height: 48px;
    padding: 0 18px;
    border-radius: 0;
    border-color: #de3c4b;
    background: #de3c4b;
    color: #f2eee7;
    text-transform: uppercase;
    letter-spacing: .07em;
    font: 500 11px 'MARFI Auth Mono', monospace;
  }
  .marfi-app .white-button:hover { background: transparent; color: #de3c4b; }

  .marfi-dropzone-form {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 380px;
    margin-top: 0 !important;
  }
  .marfi-dropzone-form file-dropzone { flex: 1; display: flex; }
  .marfi-dropzone-area {
    flex: 1;
    min-height: 380px;
    border-radius: 0 !important;
    background: #fff;
    border-color: rgba(8, 9, 13, .16) !important;
  }
  .marfi-dropzone-area:hover { background: #fff; border-color: #de3c4b !important; }

  .marfi-app-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px 30px;
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    padding: 20px 0 28px;
    border-top: 1px solid rgba(8, 9, 13, .14);
    color: #6f717a;
    font: 500 10px/1.7 'MARFI Auth Mono', monospace;
  }
  .marfi-app-footer a { color: #6f717a; text-decoration: underline; text-underline-offset: 3px; }
  .marfi-app-footer a:hover { color: #08090d; }

  @media (max-width: 760px) {
    .marfi-app-header-inner, .marfi-app-main, .marfi-app-footer { width: calc(100% - 32px); }
    .marfi-dropzone-area, .marfi-dropzone-form { min-height: 260px; }
  }
</style>
