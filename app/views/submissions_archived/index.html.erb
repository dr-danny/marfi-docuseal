<% filter_params = params.permit(Submissions::Filter::ALLOWED_PARAMS).compact_blank %>
<div>
  <%= link_to sent_path, class: 'flex items-center mb-1 md:mb-0' do %>
    <%= svg_icon('chevron_left', class: 'w-5 h-5') %>
    <span style="margin-left: 3px"><%= t('back_to_active') %></span>
  <% end %>
</div>
<div class="flex flex-col md:flex-row md:items-center mb-4 gap-3">
  <div class="group/header flex w-full justify-between items-center">
    <h1 class="text-2xl md:text-3xl font-bold"><%= t('live_agreements') %> <span class="badge badge-outline badge-lg align-middle"><%= t('archived') %></span></h1>
  </div>
  <div class="flex items-center md:items-end gap-2">
    <%= render 'submissions_filters/applied_filters', filter_params:, with_status: true, with_default_status: true %>
    <%= render 'submissions_filters/filter_button', filter_params: %>
  </div>
</div>
<% if @pagy.count.nil? || @pagy.count > 0 %>
  <%= render 'submissions/agreements_table', submissions: @submissions, with_template: true, archived: true %>
<% elsif params[:q].present? || filter_params.present? %>
  <div class="text-center">
    <div class="mt-16 text-3xl font-semibold">
      <%= t('submissions_not_found') %>
    </div>
  </div>
<% end %>
<%= render 'shared/pagination', pagy: @pagy, items_name: 'submissions' %>
