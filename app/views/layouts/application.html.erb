<!DOCTYPE html>
<html data-theme="docuseal" lang="<%= I18n.locale %>">
  <head>
    <%= render 'layouts/head_tags' %>
    <% if Docuseal.enable_pwa? %>
      <link rel="manifest" href="/manifest.json">
    <% end %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <%= csrf_meta_tags %>
    <% if ENV['ROLLBAR_CLIENT_TOKEN'] %>
      <meta name="rollbar-token" content="<%= ENV.fetch('ROLLBAR_CLIENT_TOKEN', nil) %>">
      <%= javascript_pack_tag 'rollbar', 'application', defer: true %>
    <% else %>
      <%= javascript_pack_tag 'application', defer: true %>
    <% end %>
    <% if canonical_url = content_for(:canonical_url) %>
      <link href="<%= canonical_url %>" rel="canonical">
    <% end %>
    <%= stylesheet_pack_tag 'application', media: 'all' %>
  </head>
  <body>
    <% landing_page = controller_name == 'dashboard' && action_name == 'index' && !signed_in? %>
    <% sign_in_page = controller_name.in?(%w[sessions hexclave_pilot]) && !signed_in? %>
    <% if params[:modal].present? %>
      <% modal_uri = Addressable::URI.parse(params[:modal]) %>
      <% url_params = Rails.application.routes.recognize_path(modal_uri.path, method: :get) %>
      <% if url_params[:action] == 'new' %>
        <open-modal src="<%= url_for(**url_params, params: modal_uri.query_values) %>"></open-modal>
      <% end %>
    <% end %>
    <turbo-frame id="modal"></turbo-frame>
    <turbo-frame id="drawer"></turbo-frame>
    <% if sign_in_page %>
      <%= render 'shared/marfi_auth_styles' %>
      <div class="marfi-auth-page">
        <header class="marfi-auth-header">
          <a class="marfi-auth-brand" href="<%= root_path %>" aria-label="MARFI Secure eSIGN home">
            <img src="/marfi-logo.png" alt="" width="36" height="36">
            <span>MARFI</span>
          </a>
          <a class="marfi-auth-back" href="<%= root_path %>">Back to portal</a>
        </header>
        <main class="marfi-auth-main">
          <div class="marfi-auth-lockup" aria-hidden="true"><span>Secure</span> <span>eSIGN</span></div>
          <section class="marfi-auth-card" aria-label="Account sign-in">
            <%= render 'shared/flash' if flash.present? %>
            <%= yield %>
          </section>
        </main>
        <footer class="marfi-auth-footer">
          <nav aria-label="Legal and security">
            <a href="https://marfi.ai/legal/privacy/" target="_blank" rel="noopener">Privacy</a>
            <a href="https://marfi.ai/legal/terms/" target="_blank" rel="noopener">Terms</a>
            <a href="https://trust.marfi.io/monitoring" target="_blank" rel="noopener">Security</a>
          </nav>
          <span class="marfi-auth-attribution">Forked from <a href="<%= Docuseal::GITHUB_URL %>" target="_blank" rel="noopener">DocuSeal OSS</a></span>
        </footer>
      </div>
    <% else %>
      <% unless landing_page %>
        <%= render 'shared/marfi_app_styles' %>
        <div class="marfi-app">
          <%= render 'shared/navbar' %>
          <% if flash.present? %><%= render 'shared/flash' %><% end %>
          <div class="marfi-app-main">
            <%= yield %>
          </div>
          <% unless signed_in? %>
            <footer class="marfi-app-footer">
              <span>Forked from <a href="<%= Docuseal::GITHUB_URL %>" target="_blank" rel="noopener">DocuSeal OSS</a></span>
            </footer>
          <% end %>
        </div>
      <% else %>
        <%= yield %>
      <% end %>
    <% end %>
    <%= render 'shared/body_scripts' %>
  </body>
</html>
