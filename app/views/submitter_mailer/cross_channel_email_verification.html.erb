<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background-color: #fffaf3; padding: 32px 16px;">
  <div style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; padding: 32px;">
    <div style="margin-bottom: 24px;">
      <h1 style="color: #08090d; font-size: 24px; font-weight: 600; margin: 0 0 16px 0;">MARFI Secure eSIGN</h1>
      <p style="color: #666; font-size: 16px; margin: 0;">
        <%= t('your_verification_code_to_access_the_name', name: @submitter.submission.name || @submitter.submission.template&.name) %>
      </p>
    </div>

    <div style="background-color: #f2eee7; border: 2px solid #de3c4b; border-radius: 6px; padding: 24px; text-align: center; margin: 24px 0;">
      <p style="color: #666; font-size: 14px; margin: 0 0 12px 0;">Your verification code</p>
      <p style="color: #08090d; font-size: 36px; font-weight: 700; letter-spacing: 4px; margin: 0; font-family: 'Monaco', 'Courier New', monospace;"><%= @otp_code %></p>
      <p style="color: #999; font-size: 12px; margin: 12px 0 0 0;">Valid for 15 minutes</p>
    </div>

    <div style="margin: 24px 0;">
      <p style="color: #666; font-size: 14px; margin: 0;">
        This code is for your security. Do not share it with anyone.
      </p>
    </div>

    <div style="border-top: 1px solid #e0e0e0; padding-top: 24px; margin-top: 24px;">
      <p style="color: #999; font-size: 12px; margin: 0;">
        <%= t('please_reply_to_this_email_if_you_didnt_request_this') %>
      </p>
      <p style="color: #999; font-size: 12px; margin: 8px 0 0 0;">
        MARFI Systems Inc. | esign@secure.marfi.app
      </p>
    </div>
  </div>
</div>
