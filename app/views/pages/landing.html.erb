<style>
  @font-face {
    font-family: 'MARFI Syne';
    font-style: normal;
    font-weight: 500 700;
    font-display: swap;
    src: url('/fonts/syne-500-700-latin.woff2') format('woff2');
  }

  @font-face {
    font-family: 'MARFI Mono';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/dm-mono-500-latin.woff2') format('woff2');
  }

  .marfi-portal {
    --ink: #08090d;
    --paper: #f2eee7;
    --brand: #de3c4b;
    --brand-bright: #ff5362;
    --pad: clamp(24px, 5vw, 84px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    padding: 0 var(--pad);
    color: var(--paper);
    background: radial-gradient(ellipse at 15% 45%, #141823 0, transparent 56%), var(--ink);
    color-scheme: dark;
  }

  .marfi-portal *, .marfi-portal *::before, .marfi-portal *::after { box-sizing: border-box; }
  .marfi-portal a { text-decoration: none; }
  .marfi-portal a:focus-visible { outline: 2px solid #99e7df; outline-offset: 6px; }

  .marfi-portal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 88px;
    flex-shrink: 0;
    border-bottom: 1px solid rgba(255, 255, 255, .14);
  }

  .marfi-portal-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: 'MARFI Syne', sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: .18em;
  }

  .marfi-portal-brand img { width: 36px; height: 36px; object-fit: contain; }

  .marfi-portal-main {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: 3vw;
    flex: 1;
    padding: clamp(48px, 8vh, 90px) 0;
  }

  .marfi-portal h1 {
    margin: 0;
    font-family: 'MARFI Syne', sans-serif;
    font-size: clamp(64px, 9.2vw, 148px);
    font-weight: 500;
    letter-spacing: -.055em;
    line-height: .94;
  }

  .marfi-portal h1 span { display: block; }
  .marfi-portal h1 span:last-child { color: var(--brand-bright); }

  .marfi-portal-signin {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-width: 160px;
    padding: 17px 18px 17px 22px;
    border: 1px solid transparent;
    color: var(--ink);
    background: var(--brand);
    font-family: 'MARFI Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .07em;
    text-transform: uppercase;
    transition: color 240ms ease, background-color 240ms ease, border-color 240ms ease;
  }

  .marfi-portal-signin:hover {
    color: var(--brand-bright);
    border-color: var(--brand-bright);
    background: transparent;
  }

  .marfi-portal-signin svg { width: 18px; height: 18px; }

  .marfi-portal-art { display: grid; place-items: center; min-width: 0; }
  .marfi-wireframe {
    display: block;
    width: 100%;
    max-width: 820px;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 24px 44px rgba(0, 0, 0, .28));
    font-family: 'MARFI Mono', monospace;
  }

  .marfi-wireframe-scan { animation: marfi-document-scan 12s ease-in-out infinite; }
  .marfi-wireframe-signature { stroke-dasharray: 310; stroke-dashoffset: 0; animation: marfi-signature-trace 12s ease-in-out infinite; }
  .marfi-wireframe-progress { stroke-dasharray: 190; animation: marfi-progress-trace 12s ease-in-out infinite; }
  .marfi-wireframe-node { animation: marfi-node-pulse 6s ease-in-out infinite; }

  @keyframes marfi-document-scan {
    0%, 10% { transform: translateY(0); opacity: 0; }
    22%, 65% { opacity: .3; }
    80%, 100% { transform: translateY(260px); opacity: 0; }
  }

  @keyframes marfi-signature-trace {
    0%, 28% { stroke-dashoffset: 310; opacity: .35; }
    62%, 90% { stroke-dashoffset: 0; opacity: .9; }
    100% { stroke-dashoffset: 0; opacity: .35; }
  }

  @keyframes marfi-progress-trace {
    0%, 20% { stroke-dashoffset: 190; opacity: .35; }
    72%, 90% { stroke-dashoffset: 0; opacity: .7; }
    100% { stroke-dashoffset: 0; opacity: .35; }
  }

  @keyframes marfi-node-pulse {
    0%, 100% { opacity: .4; }
    50% { opacity: .9; }
  }

  .marfi-portal-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 30px;
    padding: 22px 0;
    border-top: 1px solid rgba(255, 255, 255, .14);
    font-family: 'MARFI Mono', monospace;
    font-size: 10px;
    line-height: 1.7;
    color: #999ba5;
  }

  .marfi-portal-legal { display: flex; gap: 24px; }
  .marfi-portal-attribution { margin-left: auto; }

  .marfi-portal-footer a { color: #b9bac1; text-decoration: underline; text-underline-offset: 3px; }
  .marfi-portal-footer a:hover { color: var(--paper); }

  @media (max-width: 760px) {
    .marfi-portal-header { height: 76px; }
    .marfi-portal-main { grid-template-columns: 1fr; gap: 42px; padding: 48px 0; }
    .marfi-portal h1 { font-size: clamp(64px, 17vw, 118px); }
    .marfi-portal-signin { min-width: 126px; gap: 14px; padding: 12px 14px; }
    .marfi-portal-footer { font-size: 9px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marfi-portal-signin { transition: none; }
    .marfi-wireframe-scan, .marfi-wireframe-signature, .marfi-wireframe-progress, .marfi-wireframe-node { animation: none; }
    .marfi-wireframe-scan { opacity: 0; }
  }
</style>

