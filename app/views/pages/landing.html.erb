<style>
  @font-face {
    font-family: 'MARFI Syne';
    font-style: normal;
    font-weight: 500 700;
    font-display: swap;
    src: url('/fonts/syne-500-700-latin.woff2') format('woff2');
  }

  @font-face {
    font-family: 'MARFI Mono';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/dm-mono-500-latin.woff2') format('woff2');
  }

  .marfi-portal {
    --ink: #08090d;
    --paper: #f2eee7;
    --brand: #de3c4b;
    --brand-bright: #ff5362;
    --pad: clamp(24px, 5vw, 84px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    padding: 0 var(--pad);
    color: var(--paper);
    background: radial-gradient(ellipse at 15% 45%, #141823 0, transparent 56%), var(--ink);
    color-scheme: dark;
  }

  .marfi-portal *, .marfi-portal *::before, .marfi-portal *::after { box-sizing: border-box; }
  .marfi-portal a { text-decoration: none; }
  .marfi-portal a:focus-visible { outline: 2px solid #99e7df; outline-offset: 6px; }

  .marfi-portal-header {
    display: flex;
    align-items: center;
    height: 88px;
    flex-shrink: 0;
    border-bottom: 1px solid rgba(255, 255, 255, .14);
  }

  .marfi-portal-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: 'MARFI Syne', sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: .18em;
  }

  .marfi-portal-brand img { width: 36px; height: 36px; object-fit: contain; }

  .marfi-portal-main {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr);
    align-items: center;
    gap: 4vw;
    flex: 1;
    padding: clamp(64px, 10vh, 120px) 0;
  }

  .marfi-portal h1 {
    margin: 0 0 48px;
    font-family: 'MARFI Syne', sans-serif;
    font-size: clamp(72px, 10.8vw, 172px);
    font-weight: 500;
    letter-spacing: -.055em;
    line-height: .94;
  }

  .marfi-portal h1 span { display: block; }
  .marfi-portal h1 span:last-child { color: var(--brand-bright); }

  .marfi-portal-signin {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 42px;
    min-width: 240px;
    padding: 17px 18px 17px 22px;
    border: 1px solid transparent;
    color: var(--ink);
    background: var(--brand);
    font-family: 'MARFI Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .07em;
    text-transform: uppercase;
    transition: color 240ms ease, background-color 240ms ease, border-color 240ms ease;
  }

  .marfi-portal-signin:hover {
    color: var(--brand-bright);
    border-color: var(--brand-bright);
    background: transparent;
  }

  .marfi-portal-signin svg { width: 18px; height: 18px; }

  .marfi-portal-art { display: grid; place-items: center; }
  .marfi-wireframe { display: block; width: 100%; max-width: 440px; height: auto; overflow: visible; }
  .marfi-wireframe-stack { animation: marfi-document-drift 12s ease-in-out infinite; }
  .marfi-wireframe-scan { animation: marfi-document-scan 10s ease-in-out infinite; }
  .marfi-wireframe-signature { stroke-dasharray: 260; stroke-dashoffset: 0; animation: marfi-signature-trace 10s ease-in-out infinite; }

  @keyframes marfi-document-drift {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @keyframes marfi-document-scan {
    0%, 12% { transform: translateY(0); opacity: 0; }
    22% { opacity: .55; }
    70% { opacity: .55; }
    85%, 100% { transform: translateY(218px); opacity: 0; }
  }

  @keyframes marfi-signature-trace {
    0%, 35% { stroke-dashoffset: 260; opacity: .35; }
    65%, 90% { stroke-dashoffset: 0; opacity: .85; }
    100% { stroke-dashoffset: 0; opacity: .35; }
  }

  .marfi-portal-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 30px;
    padding: 22px 0;
    border-top: 1px solid rgba(255, 255, 255, .14);
    font-family: 'MARFI Mono', monospace;
    font-size: 10px;
    line-height: 1.7;
    color: #999ba5;
  }

  .marfi-portal-legal { display: flex; gap: 24px; }
  .marfi-portal-attribution { margin-left: auto; }

  .marfi-portal-footer a { color: #b9bac1; text-decoration: underline; text-underline-offset: 3px; }
  .marfi-portal-footer a:hover { color: var(--paper); }

  @media (max-width: 760px) {
    .marfi-portal-header { height: 76px; }
    .marfi-portal-main { grid-template-columns: 1fr; padding: 64px 0 72px; }
    .marfi-portal h1 { font-size: clamp(64px, 17vw, 118px); margin-bottom: 40px; }
    .marfi-portal-art { display: none; }
    .marfi-portal-signin { min-width: 220px; }
    .marfi-portal-footer { font-size: 9px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marfi-portal-signin { transition: none; }
    .marfi-wireframe-stack, .marfi-wireframe-scan, .marfi-wireframe-signature { animation: none; }
    .marfi-wireframe-scan { opacity: 0; }
  }
</style>

<section class="marfi-portal" aria-label="MARFI Secure eSIGN">
  <header class="marfi-portal-header">
    <div class="marfi-portal-brand">
      <img src="/marfi-logo.png" alt="" width="36" height="36">
      <span>MARFI</span>
    </div>
  </header>

  <main class="marfi-portal-main">
    <div>
      <h1><span>Secure</span><span>eSIGN</span></h1>
      <%= link_to new_user_session_path, class: 'marfi-portal-signin' do %>
        <span>Sign in</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      <% end %>
    </div>
    <div class="marfi-portal-art" aria-hidden="true">
      <svg class="marfi-wireframe" viewBox="0 0 480 500" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <defs>
          <linearGradient id="marfi-wireframe-edge" x1="105" y1="75" x2="380" y2="430" gradientUnits="userSpaceOnUse">
            <stop stop-color="#ff5362" stop-opacity=".85"></stop>
            <stop offset="1" stop-color="#de3c4b" stop-opacity=".3"></stop>
          </linearGradient>
          <clipPath id="marfi-document-clip">
            <path d="M124 88L292 62L365 127V363L124 405Z"></path>
          </clipPath>
        </defs>
        <g stroke="#999ba5" stroke-width=".7" opacity=".16">
          <path d="M30 434L269 478L449 406M30 434L215 359L449 406M90 445L270 372M150 456L329 384M211 467L389 396"></path>
          <path d="M76 415L315 459M122 397L360 441M168 378L405 422"></path>
        </g>
        <g class="marfi-wireframe-stack" stroke-linecap="round" stroke-linejoin="round">
          <path d="M92 116L260 90L333 155V391L92 433Z" stroke="#999ba5" stroke-opacity=".15"></path>
          <path d="M108 102L276 76L349 141V377L108 419Z" stroke="#999ba5" stroke-opacity=".27"></path>
          <path d="M124 88L292 62L365 127V363L124 405Z" stroke="url(#marfi-wireframe-edge)" stroke-width="1.3"></path>
          <path d="M292 62V139L365 127" stroke="#ff5362" stroke-width="1.1" stroke-opacity=".7"></path>
          <path d="M124 405L108 419L92 433M365 363L349 377L333 391" stroke="#999ba5" stroke-opacity=".2"></path>
          <g stroke="#f2eee7" stroke-width="1" stroke-opacity=".24">
            <path d="M157 150L248 135M157 177L325 148M157 191L325 162"></path>
            <path d="M157 227L325 198M157 241L307 215M157 255L325 226M157 269L273 249"></path>
            <path d="M157 345L263 327"></path>
          </g>
          <g clip-path="url(#marfi-document-clip)">
            <path class="marfi-wireframe-scan" d="M125 116L364 75" stroke="#ff5362" stroke-width="1" opacity="0"></path>
          </g>
          <path class="marfi-wireframe-signature" d="M162 329C181 301 188 286 182 284C172 281 170 326 181 326C190 326 199 298 195 297C189 296 192 321 200 319L212 305C213 320 220 318 228 304C229 314 239 314 249 303" stroke="#ff5362" stroke-width="1.5" opacity=".85"></path>
          <g stroke="#de3c4b" stroke-opacity=".6" stroke-width="1.1">
            <path d="M304 287L328 296V318C328 333 316 346 304 352C292 346 280 333 280 318V296Z"></path>
            <path d="M292 318L301 327L317 308"></path>
          </g>
          <g fill="#ff5362" fill-opacity=".65" stroke="none">
            <circle cx="124" cy="88" r="2"></circle>
            <circle cx="365" cy="363" r="2"></circle>
            <circle cx="124" cy="405" r="2"></circle>
          </g>
        </g>
      </svg>
    </div>
  </main>

  <footer class="marfi-portal-footer">
    <nav class="marfi-portal-legal" aria-label="Legal and security">
      <a href="https://marfi.ai/legal/privacy/" target="_blank" rel="noopener">Privacy</a>
      <a href="https://marfi.ai/legal/terms/" target="_blank" rel="noopener">Terms</a>
      <a href="https://trust.marfi.io/monitoring" target="_blank" rel="noopener">Security</a>
    </nav>
    <span class="marfi-portal-attribution">Forked from <a href="<%= Docuseal::GITHUB_URL %>" target="_blank" rel="noopener">DocuSeal OSS</a> · <a href="<%= Docuseal::SOURCE_URL %>" target="_blank" rel="noopener">Source</a></span>
  </footer>
</section>
