<% submissions = local_assigns[:selected] == 'submissions' %>
<form action="<%= root_path %>" method="get" id="templates_submissions_toggle" class="marfi-app-nav-tabs">
  <toggle-cookies data-value="templates" data-key="dashboard_view">
    <button type="submit" class="marfi-app-action<%= ' is-active' unless submissions %>" title="<%= t('templates') %>" aria-label="<%= t('templates') %>">
      <%= svg_icon('files', class: 'w-5 h-5 stroke-2') %>
      <span class="marfi-app-action-label"><%= t('templates') %></span>
    </button>
  </toggle-cookies>
  <toggle-cookies data-value="submissions" data-key="dashboard_view">
    <button type="submit" class="marfi-app-action<%= ' is-active' if submissions %>" title="<%= t('submissions') %>" aria-label="<%= t('submissions') %>">
      <%= svg_icon('send', class: 'w-5 h-5 stroke-2') %>
      <span class="marfi-app-action-label"><%= t('submissions') %></span>
    </button>
  </toggle-cookies>
</form>
