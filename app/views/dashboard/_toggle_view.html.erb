<% submissions = local_assigns[:selected] == 'submissions' %>
<form action="<%= root_path %>" method="get" id="templates_submissions_toggle" class="marfi-app-nav-tabs">
  <toggle-cookies data-value="templates" data-key="dashboard_view">
    <button type="submit" class="marfi-app-nav-link<%= ' is-active' unless submissions %>">
      <%= t('templates') %>
    </button>
  </toggle-cookies>
  <toggle-cookies data-value="submissions" data-key="dashboard_view">
    <button type="submit" class="marfi-app-nav-link<%= ' is-active' if submissions %>">
      <%= t('submissions') %>
    </button>
  </toggle-cookies>
</form>
